rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /resellerApp/sharedData {
      allow read, write: if request.auth != null;
    }

    // Inventory is stored one item per document so photos do not make the
    // shared business document exceed Firestore's 1 MiB document limit.
    match /resellerApp/sharedData/inventory/{itemId} {
      allow read, write: if request.auth != null;
    }
  }
}
